# Server Configuration - Render Deployment
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database_name?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your_strong_random_jwt_secret_key_32_chars_minimum
JWT_EXPIRE=30d

# Email Configuration (Nodemailer)
# If using a standard email like Gmail
SENDER_NAME=your_sender_name
SENDER_EMAIL=your_sender_email@gmail.com
SENDER_PASSWORD=your_sender_password
# To bypass Render Port 25/465/587 blocks on the Free Tier, use an SMTP Relay on port 2525
# SMTP_SERVICE= # Optional (e.g., 'gmail', 'sendgrid')
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=2525
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Google Drive Configuration
# Use a service account or OAuth delegated user account with access to a shared drive.
# GOOGLE_DRIVE_CLIENT_EMAIL=your_service_account_email
# GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
# GOOGLE_DRIVE_FOLDER_ID=your_shared_drive_or_folder_id

# Google Drive Configuration
GOOGLE_DRIVE_CLIENT_ID="your_google_drive_client_id"
GOOGLE_DRIVE_CLIENT_SECRET="your_google_drive_client_secret"
GOOGLE_DRIVE_REFRESH_TOKEN="your_google_drive_refresh_token"
GOOGLE_DRIVE_FOLDER_ID="your_google_drive_folder_id"



# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# Admin Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=secure_password_change_after_first_login


# Razorpay Config
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
